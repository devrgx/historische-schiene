generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  displayName  String
  passwordHash String?
  sessionVersion Int      @default(1)
  status       UserStatus @default(PENDING)
  isSystemUser Boolean    @default(false)

  member Member?

  roles UserRole[]

  activationTokens PortalActivationToken[]

  authoredPosts  NewsPost[] @relation("NewsPostAuthor")
  editedPosts    NewsPost[] @relation("NewsPostLastEditor")
  publishedPosts NewsPost[] @relation("NewsPostPublisher")

  reviewedApplications MembershipApplication[] @relation("ApplicationReviewer")
  applicationHistoryEntries MembershipApplicationHistory[] @relation("ApplicationHistoryActor")

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model PortalActivationToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdByUserId Int?
  createdByName   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("portal_activation_tokens")
}

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  requestedIp        String?
  requestedUserAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
  @@map("password_reset_tokens")
}

model Member {
  id Int @id @default(autoincrement())

  membershipNumber String         @unique
  membershipType   MembershipType

  firstName String
  lastName  String
  birthDate DateTime

  email String?
  phone String?

  street      String
  houseNumber String
  postalCode  String
  city        String
  country     String @default("Deutschland")

  occupation           String?
  railwayQualification String?
  telegramUsername     String?

  emergencyContactName  String?
  emergencyContactPhone String?

  isMinor Boolean @default(false)

  guardianFirstName    String?
  guardianLastName     String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?

  joinedAt DateTime?
  leftAt   DateTime?

  status MemberStatus @default(ACTIVE)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  application MembershipApplication?

  functions MemberClubFunction[]

  billingProfile    MemberBillingProfile?
membershipCharges MembershipCharge[]
invoices           Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([membershipType])
  @@index([postalCode])
  @@map("members")
}

model ClubFunction {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isPublic    Boolean @default(true)

  members MemberClubFunction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("club_functions")
}

model NumberSequence {
  key         String   @id
  nextValue   Int      @default(1)
  description String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}

model MemberClubFunction {
  memberId     Int
  functionId   Int
  isPrimary    Boolean   @default(false)
  validFrom    DateTime?
  validUntil   DateTime?
  displayOrder Int       @default(0)

  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  function ClubFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([memberId, functionId])
  @@index([functionId])
  @@map("member_club_functions")
}

model Role {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model NewsPost {
  id Int @id @default(autoincrement())

  title   String
  slug    String @unique
  excerpt String
  content String @db.LongText

  imageUrl String?

  category NewsCategory
  status   NewsStatus   @default(DRAFT)

  featured Boolean @default(false)

  authorId Int
  author   User @relation("NewsPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  lastEditorId Int?
  lastEditor   User? @relation("NewsPostLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)

  publishedById Int?
  publishedBy   User? @relation("NewsPostPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([authorId])
  @@index([lastEditorId])
  @@index([publishedById])
  @@map("news_posts")
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DISABLED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  EXPELLED
  DECEASED
}

enum NewsCategory {
  CLUB
  PROJECT
  EVENT
  IMPORTANT
  PRESS
}

enum NewsStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum MembershipApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum MembershipApplicationHistoryAction {
  REVIEW_STARTED
  APPROVED
  REJECTED
  WITHDRAWN
  NOTE_ADDED
}

enum MembershipType {
  ADULT
  REDUCED
  LEGAL_ENTITY
  HONORARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemType {
  MEMBERSHIP_FEE
  ADMISSION_FEE
  OTHER
  CREDIT
}

enum PaymentMethod {
  BANK_TRANSFER
  SEPA_DIRECT_DEBIT
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentAttemptStatus {
  PENDING
  SUBMITTED
  SUCCEEDED
  FAILED
  RETURNED
  CANCELLED
}

enum ReminderLevel {
  PAYMENT_REMINDER
  FIRST_REMINDER
  FINAL_REMINDER
}

enum ReminderStatus {
  DRAFT
  ISSUED
  SENT
  SETTLED
  CANCELLED
}

model MembershipApplication {
  id String @id @default(cuid())

  firstName String
  lastName  String
  birthDate DateTime

  email String
  phone String?

  street      String
  houseNumber String
  postalCode  String
  city        String
  country     String @default("Deutschland")

  membershipType MembershipType

  occupation           String?
  railwayQualification String?
  telegramUsername     String?

  emergencyContactName  String?
  emergencyContactPhone String?

  isMinor Boolean @default(false)

  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?

  guardianStreet      String?
  guardianHouseNumber String?
  guardianPostalCode  String?
  guardianCity        String?

  guardianRelationship String?

  guardianConsentAccepted    Boolean   @default(false)
  guardianAuthorityConfirmed Boolean   @default(false)
  guardianNameConfirmation   String?
  guardianConsentAt          DateTime?

  message String? @db.Text

  privacyAccepted           Boolean
  statutesAccepted          Boolean
  contributionRulesAccepted Boolean

  privacyVersion           String?
  statutesVersion          String?
  contributionRulesVersion String?

  status MembershipApplicationStatus @default(PENDING)

  reviewedById Int?
  reviewedBy   User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt      DateTime?
  decisionNote    String?   @db.Text
  rejectionReason String?   @db.Text

  memberId Int?    @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  historyEntries MembershipApplicationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([isMinor])
  @@index([reviewedById])
  @@map("membership_applications")
}

model MembershipApplicationHistory {
  id Int @id @default(autoincrement())

  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  action MembershipApplicationHistoryAction

  previousStatus MembershipApplicationStatus?
  newStatus      MembershipApplicationStatus?

  message String? @db.Text

  actorUserId Int?
  actorUser   User? @relation("ApplicationHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("membership_application_history")
}

model MemberBillingProfile {
  id Int @id @default(autoincrement())

  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  selectedMonthlyAmountCents Int?
  monthlyFeeOverrideCents    Int?
  admissionFeeOverrideCents  Int?
  admissionFeeChargedAt      DateTime?
  contributionExemptUntil    DateTime?

  preferredPaymentMethod PaymentMethod @default(BANK_TRANSFER)

  sepaMandateReference String?
  sepaMandateSignedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_billing_profiles")
}

model MembershipCharge {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  billingYear  Int
  billingMonth Int

  membershipType  MembershipType
  membershipLabel String

  monthlyAmountCents  Int
  admissionFeeCents   Int @default(0)
  totalAmountCents    Int

  invoiceId Int?     @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, billingYear, billingMonth])
  @@index([billingYear, billingMonth])
  @@index([memberId])
  @@map("membership_charges")
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique

  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  status InvoiceStatus @default(DRAFT)

  billingYear  Int
  billingMonth Int

  issueDate DateTime
  dueDate   DateTime

  currency String @default("EUR")

  subtotalCents Int
  totalCents    Int
  paidCents     Int @default(0)
  openCents     Int

  recipientMembershipNumber String
  recipientName             String
  recipientStreet           String
  recipientHouseNumber      String
  recipientPostalCode       String
  recipientCity             String
  recipientCountry          String

  issuerName        String
  issuerStreet      String
  issuerHouseNumber String
  issuerPostalCode  String
  issuerCity        String
  issuerCountry     String
  issuerEmail       String?
  issuerPhone       String?
  issuerWebsite     String?

  issuerAccountHolder String?
  issuerIban          String?
  issuerBic           String?
  issuerBankName      String?

  contributionResolutionNote String? @db.Text

  pdfStoragePath String?
  pdfSha256      String?
  pdfSizeBytes   Int?
  pdfGeneratedAt DateTime?

  finalizedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String? @db.Text

  items            InvoiceItem[]
payments         Payment[]
paymentAttempts  PaymentAttempt[]
reminders        Reminder[]
membershipCharge MembershipCharge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([billingYear, billingMonth])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position Int
  type     InvoiceItemType

  description String
  quantity    Int @default(1)

  unitAmountCents  Int
  totalAmountCents Int

  createdAt DateTime @default(now())

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@index([type])
  @@map("invoice_items")
}

model Payment {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amountCents Int

  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  paidAt DateTime

  reference String?
  note      String? @db.Text

  recordedByUserId Int?
  recordedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@index([reference])
  @@map("payments")
}

model PaymentAttempt {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  method PaymentMethod
  status PaymentAttemptStatus @default(PENDING)

  amountCents Int

  requestedAt DateTime @default(now())
  scheduledFor DateTime?

  submittedAt DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  returnedAt  DateTime?
  cancelledAt DateTime?

  providerReference String?
  endToEndId         String?

  failureCode    String?
  failureMessage String? @db.Text

  /**
   * Kosten, die der Bank oder dem Zahlungsdienstleister
   * tatsächlich durch eine Rücklastschrift entstanden sind.
   */
  bankReturnFeeCents Int @default(0)

  /**
   * Betrag, der dem Mitglied tatsächlich weiterberechnet wird.
   * Dieser Wert kann kleiner als die Bankgebühr oder 0 sein.
   */
  chargeableReturnFeeCents Int @default(0)

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([scheduledFor])
  @@index([endToEndId])
  @@index([providerReference])
  @@map("payment_attempts")
}

model Reminder {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  reminderNumber String @unique

  level  ReminderLevel
  status ReminderStatus @default(DRAFT)

  issuedAt DateTime
  dueAt    DateTime

  /**
   * Noch offener Rechnungsbetrag zum Zeitpunkt
   * der Erstellung der Mahnung.
   */
  principalCents Int

  reminderFeeCents Int @default(0)
  returnFeeCents   Int @default(0)
  interestCents   Int @default(0)

  totalOpenCents Int

  /**
   * Empfänger-Snapshot.
   *
   * Eine später geänderte Anschrift verändert die
   * bereits erstellte Mahnung nicht.
   */
  recipientMembershipNumber String
  recipientName             String
  recipientStreet           String
  recipientHouseNumber      String
  recipientPostalCode       String
  recipientCity             String
  recipientCountry          String

  note String? @db.Text

  pdfStoragePath String?
  pdfSha256      String?
  pdfSizeBytes   Int?
  pdfGeneratedAt DateTime?

  sentAt      DateTime?
  settledAt   DateTime?
  cancelledAt DateTime?

  cancellationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([level])
  @@index([dueAt])
  @@map("reminders")
}

model InvoiceSequence {
  id Int @id @default(autoincrement())

  /**
   * Für jedes Kalenderjahr existiert genau ein Zähler.
   */
  year Int @unique

  /**
   * Zuletzt vergebene laufende Nummer.
   */
  currentValue Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}